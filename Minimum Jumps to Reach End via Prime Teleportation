 Minimum Jumps to Reach End via Prime Teleportation

You are given an integer array nums of length n.

You start at index 0, and your goal is to reach index n - 1.

From any index i, you may perform one of the following operations:

Adjacent Step: Jump to index i + 1 or i - 1, if the index is within bounds.
Prime Teleportation: If nums[i] is a prime number p, you may instantly jump to any index j != i such that nums[j] % p == 0.
Return the minimum number of jumps required to reach index n - 1.


/**
 * @param {number[]} nums
 * @return {number}
 */
var minJumps = function(nums) {
    const n = nums.length;
    if (n === 1) return 0;

    // ---------- Prime Sieve ----------
    const maxVal = Math.max(...nums);
    const isPrime = Array(maxVal + 1).fill(true);

    if (maxVal >= 0) isPrime[0] = false;
    if (maxVal >= 1) isPrime[1] = false;

    for (let i = 2; i * i <= maxVal; i++) {
        if (isPrime[i]) {
            for (let j = i * i; j <= maxVal; j += i) {
                isPrime[j] = false;
            }
        }
    }

    // ---------- Build map: prime factor -> indices ----------
    const primeToIndices = new Map();

    function getPrimeFactors(x) {
        const factors = [];

        let num = x;

        for (let d = 2; d * d <= num; d++) {
            if (num % d === 0) {
                factors.push(d);

                while (num % d === 0) {
                    num /= d;
                }
            }
        }

        if (num > 1) factors.push(num);

        return factors;
    }

    for (let i = 0; i < n; i++) {
        const factors = getPrimeFactors(nums[i]);

        for (const p of factors) {
            if (!primeToIndices.has(p)) {
                primeToIndices.set(p, []);
            }

            primeToIndices.get(p).push(i);
        }
    }

    // ---------- BFS ----------
    const queue = [[0, 0]]; // [index, steps]
    const visited = Array(n).fill(false);
    visited[0] = true;

    // avoid processing same prime teleport multiple times
    const usedPrime = new Set();

    while (queue.length) {
        const [i, steps] = queue.shift();

        if (i === n - 1) return steps;

        // adjacent moves
        for (const ni of [i - 1, i + 1]) {
            if (ni >= 0 && ni < n && !visited[ni]) {
                visited[ni] = true;
                queue.push([ni, steps + 1]);
            }
        }

        // prime teleportation
        const val = nums[i];

        if (isPrime[val] && !usedPrime.has(val)) {
            usedPrime.add(val);

            const targets = primeToIndices.get(val) || [];

            for (const j of targets) {
                if (!visited[j]) {
                    visited[j] = true;
                    queue.push([j, steps + 1]);
                }
            }
        }
    }

    return -1;
};
